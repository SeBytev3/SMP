# Test Environment Variables
NODE_ENV=test
PORT=4000
API_URL=http://localhost:4000

# Database
DATABASE_URL="postgresql://postgres:postgres@db:5432/services_marketplace_test?schema=public"

# JWT Configuration
JWT_SECRET=Prueba123*
JWT_EXPIRATION=24h
JWT_COOKIE_EXPIRATION=1

# File Upload
AWS_ACCESS_KEY_ID=mock-key
AWS_SECRET_ACCESS_KEY=mock-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=mock-bucket

# Admin Default Credentials
ADMIN_EMAIL=admin@marketplace.com
ADMIN_PASSWORD=Prueba123*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Message Throttling
MESSAGE_THROTTLE_MAX=100
MESSAGE_THROTTLE_WINDOW_MS=60000

# File Upload Limits
MAX_FILE_SIZE=5242880
MAX_PORTFOLIO_IMAGES=10

# CORS
CORS_ORIGIN=http://localhost:3000
